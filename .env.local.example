# Beehiiv  -  for /writing page to list published newsletter issues
# API key: Beehiiv dashboard → Settings → Integrations → API → create a key
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_9d8489db-bf00-4c32-bf81-7756754961ec

# Supabase  -  comments and likes storage (server-side only, never exposed to
# the client). Same project finlay-dashboard uses.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin token for the comment moderation route (PATCH /api/comments/[id]).
# Any long random string; send it as `Authorization: Bearer <token>`.
ADMIN_TOKEN=
